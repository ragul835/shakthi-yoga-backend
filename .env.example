# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenyoga?schema=public"

# JWT
JWT_SECRET="zenyoga-super-secret-key-change-in-production"
JWT_RESET_SECRET="use-a-separate-random-secret-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# App
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000,http://3.107.213.215"

# Studio schedule and attendance check-in policy
CLASS_TIME_ZONE="America/Los_Angeles"
ATTENDANCE_CHECK_IN_BEFORE_MINUTES=15
ATTENDANCE_CHECK_IN_AFTER_MINUTES=0

# Optional AI assistant (the API starts without these; /api/ai/ask returns 503)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Development/demo only. Simulated purchases are always disabled in production.
ALLOW_SIMULATED_PASS_PURCHASES=false
